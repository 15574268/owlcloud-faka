# 宝塔 / 外层 Nginx：HTTPS 终止后反代到本机映射端口（默认 29101）。
# 证书路径按面板实际修改。install-tenant.sh 会替换 ADMIN/SHOP 域名和 HTTP_BIND_HERE。

server {
  listen 80;
  server_name ADMIN_DOMAIN_HERE SHOP_DOMAIN_HERE;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ADMIN_DOMAIN_HERE;
  ssl_certificate     /path/to/admin/fullchain.pem;
  ssl_certificate_key /path/to/admin/privkey.pem;
  client_max_body_size 20m;

  location ~ ^/api/(admin|shop)/cs/sessions/[^/]+/stream$ {
    proxy_pass http://127.0.0.1:HTTP_BIND_HERE;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 3600s;
  }
  location / {
    proxy_pass http://127.0.0.1:HTTP_BIND_HERE;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name SHOP_DOMAIN_HERE;
  ssl_certificate     /path/to/shop/fullchain.pem;
  ssl_certificate_key /path/to/shop/privkey.pem;
  client_max_body_size 20m;

  location ~ ^/api/shop/cs/sessions/[^/]+/stream$ {
    proxy_pass http://127.0.0.1:HTTP_BIND_HERE;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 3600s;
  }
  location ^~ /api/admin/ { return 404; }
  location ^~ /api/internal/ { return 404; }
  location ^~ /api/install/ { return 404; }
  location / {
    proxy_pass http://127.0.0.1:HTTP_BIND_HERE;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
